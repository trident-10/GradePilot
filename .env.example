# GradePilot environment template
# Copy values into a local, untracked file (.env or web/.env.local).
# These are public configuration, not API keys or credentials.

# --- CORS ---
# Comma-separated browser origins. Never use *.
# Local development:
GRADEPILOT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Production: set the real frontend origin(s) explicitly, for example:
# GRADEPILOT_CORS_ORIGINS=https://YOUR_PRODUCTION_FRONTEND_ORIGIN

# --- Reverse proxy / client IP ---
# Keep 0 unless the API sits behind a reverse proxy YOU control that
# overwrites or appends X-Forwarded-For. Direct-to-internet deployments
# must leave this off; clients can spoof X-Forwarded-For.
GRADEPILOT_TRUST_PROXY=0

# --- Rate limits (requests per window per client) ---
GRADEPILOT_RATE_LIMIT_ANALYZE=5
GRADEPILOT_RATE_LIMIT_CALCULATION=30
# GRADEPILOT_RATE_LIMIT_WINDOW_SECONDS=60
# GRADEPILOT_RATE_LIMIT_MAX_KEYS=4096

# --- API docs (/docs, /redoc, /openapi.json) ---
# Local default is on. Production should disable public docs:
GRADEPILOT_ENABLE_API_DOCS=1
# GRADEPILOT_ENABLE_API_DOCS=0

# --- HSTS ---
# Never enable on local HTTP. Only set 1 when the API is served exclusively
# over HTTPS (usually terminate TLS at the reverse proxy and set HSTS there).
GRADEPILOT_ENABLE_HSTS=0
